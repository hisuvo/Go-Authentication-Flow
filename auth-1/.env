DATABASE_URL="host=localhost user=postgres password=12345 dbname=authentication port=5432 sslmode=disable TimeZone=Asia/Dhaka"
PORT=5000

# JWT
JWT_SECRET=your-long-random-secret-at-least-32-bytes
JWT_ISSUER=tenant-management-api
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Refresh cookie
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=false # On production use COOKIE_SECURE=true
COOKIE_SAME_SITE=lax